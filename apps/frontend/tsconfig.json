{
  "extends": "@repo/typescript-config/nextjs",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true,
    "paths": {
      "@/*": ["./*"],
      "@repo/shared": ["./node_modules/@repo/shared/dist/index.d.ts"],
      "@repo/shared/*": ["./node_modules/@repo/shared/dist/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.js",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
