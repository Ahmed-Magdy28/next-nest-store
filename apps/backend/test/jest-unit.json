{
    "moduleFileExtensions": [
        "js",
        "json",
        "ts"
    ],
    "rootDir": "..",
    "testEnvironment": "node",
    "testMatch": [
        "<rootDir>/test/**/*.spec.ts"
    ],
    "testPathIgnorePatterns": [
        "<rootDir>/test/e2e/"
    ],
    "transform": {
        "^.+\\.(t|j)s$": [
            "ts-jest",
            {
                "tsconfig": {
                    "module": "commonjs"
                }
            }
        ]
    },
    "moduleNameMapper": {
        "^@repo/database$": "<rootDir>/../../packages/database/src/index.ts",
        "^@repo/database/(.*)$": "<rootDir>/../../packages/database/src/$1",
        "^(\\.{1,2}/.*)\\.js$": "$1"
    }
}