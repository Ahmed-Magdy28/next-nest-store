{
  "extends": "@repo/typescript-config/node",
  "compilerOptions": {
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "removeComments": true,
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "incremental": false,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@repo/shared": ["./node_modules/@repo/shared/dist/index.d.ts"],
      "@repo/shared/*": ["./node_modules/@repo/shared/dist/*"]
    },
    "types": ["node", "jest"],
    "allowJs": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
