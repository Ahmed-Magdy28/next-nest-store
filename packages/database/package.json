{
  "name": "@repo/database",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "generate": "dotenv -e ../../.env -- prisma generate --schema=./prisma/schema.prisma",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev --schema=./prisma/schema.prisma",
    "migrate:test": "dotenv -e ../../.env -- sh -c 'DATABASE_URL=\"$DATABASE_TEST_URL\" prisma migrate deploy --schema=./prisma/schema.prisma'",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy --schema=./prisma/schema.prisma",
    "migrate:reset": "dotenv -e ../../.env -- prisma migrate reset --schema=./prisma/schema.prisma --force",
    "db:push": "dotenv -e ../../.env -- prisma db push --schema=./prisma/schema.prisma --force-reset",
    "studio": "dotenv -e ../../.env -- prisma studio --schema=./prisma/schema.prisma",
    "migrate:status": "dotenv -e ../../.env -- prisma migrate status --schema=./prisma/schema.prisma",
    "seed": "dotenv -e ../../.env -- tsx src/seed/index.ts",
    "reset": "pnpm migrate:reset"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/testing": "^11.2.3",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@repo/typescript-config": "workspace:*",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.5.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.19.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2"
  }
}