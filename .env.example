# ==============================================================================
#  Next Nest Store — Environment Configuration Template (.env.example)
#  Copy this file to .env and configure the values for your environment.
# ==============================================================================

# ─────────────────────────────────────────────────────────────
#  1. General Environment
# ─────────────────────────────────────────────────────────────
NODE_ENV=development # development | production | test
siteTitle="Next Nest Store"

# ─────────────────────────────────────────────────────────────
#  2. Backend (NestJS API)
# ─────────────────────────────────────────────────────────────
PORT=3000
BACKEND_PORT=3000

# Minimum 32 characters for JWT signing
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long

# Minimum 16 characters for administrative operations (e.g., seeding or admin endpoints)
ADMIN_SECRET=replace_with_a_secure_admin_key_min_16_characters

# Comma-separated list of allowed origins (e.g., http://localhost:4000,https://yourstore.com)
# NOTE: Required when NODE_ENV=production
CORS_ORIGIN=http://localhost:4000,http://localhost:3000

# Allow guest carts via signed cookies
ENABLE_GUEST_CART=true

# ─────────────────────────────────────────────────────────────
#  3. Frontend (Next.js)
# ─────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_PORT=4000

# Public URL of the NestJS Backend API (accessible from client browser and server)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Public URL of the Next.js Storefront
NEXT_PUBLIC_SITE_URL=http://localhost:4000

# ─────────────────────────────────────────────────────────────
#  4. Database (PostgreSQL & Prisma)
# ─────────────────────────────────────────────────────────────
# Standard PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:password@localhost:5432/next_nest_store?schema=public

# Connection string for automated E2E testing
DATABASE_TEST_URL=postgresql://postgres:password@localhost:5432/next_nest_store_test?schema=public&connection_limit=1

# Local Docker Postgres credentials
POSTGRES_USER=next_nest_store
POSTGRES_PASSWORD=secure_postgres_password
POSTGRES_DB=next_nest_store
POSTGRES_DB_TEST=next_nest_store_test
