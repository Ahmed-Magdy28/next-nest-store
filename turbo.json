{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DEFAULT_LOCALE",
    "BACKEND_PORT",
    "ADMIN_PORT",
    "ADMIN_SITE_TITLE",
    "Frontend_PORT",
    "FRONTEND_PORT",
    "DATABASE_URL",
    "DATABASE_TEST_URL",
    "JWT_SECRET",
    "NODE_ENV",
    "CORS_ORIGIN",
    "NEXT_PUBLIC_API_URL",
    "ADMIN_SECRET",
    "ENABLE_GUEST_CART"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    }
  }
}