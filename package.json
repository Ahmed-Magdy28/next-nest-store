{
  "name": "next-nest-store",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "/* Local Development (بدون Docker نهائياً) */": "",
    "dev": "turbo run dev",
    "dev:frontend": "turbo run dev --filter=frontend",
    "dev:backend": "turbo run dev --filter=backend",
    "/* Local DB Only (لو عايز تشغل داتابيز دوكر وتطور كودك لوكل) */": "",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "/* Full Docker Development (تشغيل كل التطبيق داخل Docker) */": "",
    "docker:dev": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v",
    "/* Docker Individual Services */": "",
    "docker:backend:up": "docker compose up -d backend",
    "docker:backend:dev": "docker compose up backend",
    "docker:backend:build": "docker compose build --no-cache backend",
    "docker:backend:logs": "docker compose logs -f backend",
    "docker:backend:down": "docker compose stop backend",
    "docker:frontend:up": "docker compose up -d frontend",
    "docker:frontend:dev": "docker compose up frontend",
    "docker:frontend:build": "docker compose build --no-cache frontend",
    "docker:frontend:logs": "docker compose logs -f frontend",
    "docker:frontend:down": "docker compose stop frontend",
    "/* Database & Tooling Scripts */": "",
    "db:generate": "pnpm --filter @repo/database generate",
    "db:migrate": "pnpm --filter @repo/database migrate",
    "db:migrate:status": "pnpm --filter @repo/database migrate:status",
    "db:migrate:test": "pnpm --filter @repo/database migrate:test",
    "db:studio": "pnpm --filter @repo/database studio",
    "db:push": "pnpm --filter @repo/database push",
    "db:reset": "pnpm --filter @repo/database reset",
    "db:seed": "pnpm --filter @repo/database seed",
    "db:format": "pnpm --filter @repo/database format",
    "test:e2e": "pnpm --filter backend test:e2e",
    "test:unit": "pnpm --filter backend test:unit",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  }
}